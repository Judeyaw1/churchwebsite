# Hosting.com Environment Variables
# Copy these to your Hosting.com control panel environment variables section

# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database

# Server Configuration
PORT=3000
NODE_ENV=production
BASE_URL=https://yourdomain.com

# Admin Configuration (change these!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key-here
FROM_EMAIL=noreply@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# OneDrive Integration (Optional)
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
MICROSOFT_TENANT_ID=common
ONEDRIVE_REDIRECT_URI=https://yourdomain.com/onedrive-callback
ONEDRIVE_TARGET_FOLDER=ChurchGallery

