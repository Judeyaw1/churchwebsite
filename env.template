# ========================================
# CHURCH WEBSITE ENVIRONMENT CONFIGURATION
# ========================================
# Copy this file to .env and update the values

# Database Configuration
# ======================
# Replace with your actual PostgreSQL database URL
DATABASE_URL=postgresql://username:password@localhost:5432/church_website

# Examples for different database providers:
# 
# Local PostgreSQL:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/church_website
#
# Neon Database (recommended for production):
# DATABASE_URL=postgresql://username:password@ep-xxx-xxx.us-east-1.aws.neon.tech/church_website?sslmode=require
#
# Supabase:
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
#
# Railway:
# DATABASE_URL=postgresql://postgres:password@containers-us-west-xxx.railway.app:5432/railway

# Server Configuration
# ====================
# Port for the server (default: 5000)
PORT=5000

# Environment (development/production)
NODE_ENV=development

# Admin Configuration
# ===================
# Default admin credentials (change in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=church2024

# Optional: JWT Secret for production authentication
# JWT_SECRET=your-super-secret-jwt-key-here

# ========================================
# SETUP INSTRUCTIONS
# ========================================
# 1. Copy this file: cp env.template .env
# 2. Update DATABASE_URL with your actual database credentials
# 3. Run: npm run db:push (create database tables)
# 4. Run: npm run db:seed (add sample data)
# 5. Run: npm run dev (start the server)
#
# For more detailed setup instructions, see DATABASE_SETUP.md
