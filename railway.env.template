# Railway Environment Variables Template
# Copy this file to Railway environment variables

# Database Configuration
DATABASE_URL=postgresql://username:password@hostname:port/database?sslmode=require

# Server Configuration
PORT=3000
NODE_ENV=production

# Admin Authentication (optional - defaults to simple token auth)
ADMIN_TOKEN=your-secure-admin-token

# Optional: Email Configuration (if using contact form)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@yourchurch.org
ADMIN_EMAIL=admin@yourchurch.org
